{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "SessionStart": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/harness/orientation.mjs\"", "timeout": 20 }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/harness/context-guard.mjs\"", "timeout": 10 }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PROJECT_DIR}/scripts/harness/context-guard.mjs\"", "timeout": 10 }] }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(npm run verify)",
      "Bash(npm run verify:*)",
      "Bash(npm test)",
      "Bash(npm run typecheck)",
      "Bash(node scripts/harness/check.mjs:*)",
      "Bash(node scripts/harness/metrics.mjs:*)",
      "Bash(node scripts/harness/orientation.mjs)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git push origin main)",
      "Bash(git show:*)",
      "Bash(agent-lens report:*)",
      "Bash(agent-lens doctor:*)"
    ],
    "deny": [
      "Bash(npm publish:*)",
      "Read(./dist/**)",
      "Read(./dashboard/dist/**)",
      "Edit(./dist/**)",
      "Edit(./core/migrations.lock.json)"
    ]
  }
}
